package org.firstinspires.ftc.teamcode;

import com.qualcomm.hardware.rev.RevHubOrientationOnRobot;
import com.qualcomm.robotcore.eventloop.opmode.Autonomous;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.hardware.CRServo;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorSimple;
import com.qualcomm.robotcore.hardware.IMU;
import com.qualcomm.robotcore.util.ElapsedTime;

import org.firstinspires.ftc.robotcore.external.navigation.AngleUnit;

/**
 * Autonomous, in this order:
 *   1. Shoot (the intake runs during the shot)
 *   2. Move backward
 *   3. Turn left
 *   4. Move forward about 24 inches
 *
 * The robot starts the shot from wherever it is placed, so line it up before the match.
 * TUNE anything marked TUNE on the real robot and FIELD.
 */
@Autonomous(name = "robotAutonomousShootAndMove", group = "Autonomous")
public class robotAutonomousShootAndMove extends LinearOpMode {

    private DcMotor frontLeft;
    private DcMotor frontRight;
    private DcMotor backLeft;
    private DcMotor backRight;

    private DcMotor launcherMotor;
    private CRServo feederServo;

    private DcMotor intakeMotor;
    private CRServo intakeServoLeft;
    private CRServo intakeServoRight;

    private IMU imu;

    // Heading the robot is supposed to be facing: 0 = starting direction, positive = left
    private double targetHeading = 0;

    private final ElapsedTime runtime = new ElapsedTime();

    private static final double COUNTS_PER_MOTOR_REV = 537.7;
    private static final double GEAR_REDUCTION = 1.0;
    private static final double WHEEL_DIAMETER_INCHES = 3.78;

    private static final double COUNTS_PER_INCH =
            (COUNTS_PER_MOTOR_REV * GEAR_REDUCTION)
                    / (WHEEL_DIAMETER_INCHES * Math.PI);

    // ---- Launcher / feeder ----
    private static final double LAUNCHER_POWER = 0.575;
    private static final long LAUNCHER_SPINUP_MS = 1500;   // TUNE: time for the launcher wheel to reach speed
    private static final double FEEDER_POWER = 1.0;
    private static final int FEEDER_STEPS = 4;             // 4 spins of 90 degrees = one full turn
    private static final long FEEDER_PULSE_MS = 250;       // TUNE: how long the feeder spins about 90 degrees
    private static final long FEEDER_GAP_MS = 500;         // pause between feeder spins

    // ---- Intake (matches the TeleOp: right servo reversed, both servos at -1.0, motor at 1.0) ----
    private static final double INTAKE_SERVO_POWER = -1.0;
    private static final double INTAKE_MOTOR_POWER = 1.0;

    // ---- Moves ----
    private static final double DRIVE_POWER = 0.5;
    private static final double DRIVE_TIMEOUT_SECONDS = 10.0;
    private static final double BACK_INCHES = 12.0;        // TUNE: how far to back up after shooting
    private static final double TURN_LEFT_DEGREES = 90.0;  // TUNE: how far to turn left
    private static final double FORWARD_INCHES = 24.0;     // drive forward about 24 inches

    // ---- IMU turning ----
    private static final double TURN_POWER = 0.5;
    private static final double TURN_MIN_POWER = 0.12;
    private static final double TURN_KP = 0.02;
    private static final double TURN_TOLERANCE_DEGREES = 1.0;
    private static final double TURN_TIMEOUT_SECONDS = 3.0;
    private static final double TURN_SETTLE_SECONDS = 0.25;

    @Override
    public void runOpMode() {

        frontLeft = hardwareMap.get(DcMotor.class, "front_left_motor");
        frontRight = hardwareMap.get(DcMotor.class, "front_right_motor");
        backLeft = hardwareMap.get(DcMotor.class, "back_left_motor");
        backRight = hardwareMap.get(DcMotor.class, "back_right_motor");

        launcherMotor = hardwareMap.get(DcMotor.class, "launcherMotor");
        feederServo = hardwareMap.get(CRServo.class, "feederServo");

        intakeMotor = hardwareMap.get(DcMotor.class, "intakeMotor");
        intakeServoLeft = hardwareMap.get(CRServo.class, "intakeServoLeft");
        intakeServoRight = hardwareMap.get(CRServo.class, "intakeServoRight");

        // IMU: Control Hub logo facing up, USB ports pointing toward the front of the robot
        imu = hardwareMap.get(IMU.class, "imu");
        imu.initialize(new IMU.Parameters(new RevHubOrientationOnRobot(
                RevHubOrientationOnRobot.LogoFacingDirection.UP,
                RevHubOrientationOnRobot.UsbFacingDirection.FORWARD)));
        imu.resetYaw();

        frontLeft.setDirection(DcMotor.Direction.REVERSE);
        backLeft.setDirection(DcMotor.Direction.REVERSE);
        frontRight.setDirection(DcMotor.Direction.FORWARD);
        backRight.setDirection(DcMotor.Direction.FORWARD);

        frontLeft.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        frontRight.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        backLeft.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);
        backRight.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.BRAKE);

        launcherMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        launcherMotor.setPower(0);

        // NOTE: the TeleOp does not reverse the feeder. If the feeder pushes the wrong way in one of
        // the two programs, make them match.
        feederServo.setDirection(CRServo.Direction.REVERSE);
        feederServo.setPower(0);

        // Same as the TeleOp: the two intake servos face each other, so one is reversed.
        intakeServoRight.setDirection(DcMotorSimple.Direction.REVERSE);
        intakeMotor.setMode(DcMotor.RunMode.RUN_WITHOUT_ENCODER);
        setIntake(false);

        telemetry.addLine("Ready");
        telemetry.update();

        waitForStart();

        if (!opModeIsActive()) return;

        // STEP 1: Shoot, with the intake running
        shootWithIntake();

        // STEP 2: Move backward
        driveForwardInches(-BACK_INCHES, DRIVE_POWER);

        // STEP 3: Turn left
        turnToHeading(targetHeading + TURN_LEFT_DEGREES);

        // STEP 4: Move forward about 24 inches
        driveForwardInches(FORWARD_INCHES, DRIVE_POWER);

        stopAllMotors();
    }

    private void setIntake(boolean on) {
        intakeServoLeft.setPower(on ? INTAKE_SERVO_POWER : 0.0);
        intakeServoRight.setPower(on ? INTAKE_SERVO_POWER : 0.0);
        intakeMotor.setPower(on ? INTAKE_MOTOR_POWER : 0.0);
    }

    // The launcher spins up first, then the feeder turns 90 degrees at a time with a gap between turns,
    // until it has made one full 360 degree turn. The intake runs the whole time, then everything stops.
    private void shootWithIntake() {

        launcherMotor.setPower(LAUNCHER_POWER);
        setIntake(true);
        sleep(LAUNCHER_SPINUP_MS);

        for (int i = 0; i < FEEDER_STEPS && opModeIsActive(); i++) {

            feederServo.setPower(FEEDER_POWER);
            sleep(FEEDER_PULSE_MS);

            feederServo.setPower(0);
            sleep(FEEDER_GAP_MS);
        }

        launcherMotor.setPower(0);
        feederServo.setPower(0);
        setIntake(false);
    }

    private void driveForwardInches(double inches, double power) {

        int counts = (int) Math.round(inches * COUNTS_PER_INCH);

        frontLeft.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        frontRight.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        backLeft.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);
        backRight.setMode(DcMotor.RunMode.STOP_AND_RESET_ENCODER);

        frontLeft.setTargetPosition(counts);
        frontRight.setTargetPosition(counts);
        backLeft.setTargetPosition(counts);
        backRight.setTargetPosition(counts);

        frontLeft.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        frontRight.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        backLeft.setMode(DcMotor.RunMode.RUN_TO_POSITION);
        backRight.setMode(DcMotor.RunMode.RUN_TO_POSITION);

        setDrivePower(Math.abs(power));

        runtime.reset();

        while (opModeIsActive()
                && runtime.seconds() < DRIVE_TIMEOUT_SECONDS
                && (frontLeft.isBusy()
                || frontRight.isBusy()
                || backLeft.isBusy()
                || backRight.isBusy())) {
            idle();
        }

        setDrivePower(0);

        // Back to normal mode, so the turns that follow actually spin the wheels
        frontLeft.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        frontRight.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        backLeft.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        backRight.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
    }

    // Turn until the IMU heading matches the target heading. Targets are absolute,
    // so a small error in one turn doesn't carry into the next one.
    private void turnToHeading(double target) {

        targetHeading = normalizeDegrees(target);

        setDrivePower(0);
        waitSeconds(TURN_SETTLE_SECONDS);

        frontLeft.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        frontRight.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        backLeft.setMode(DcMotor.RunMode.RUN_USING_ENCODER);
        backRight.setMode(DcMotor.RunMode.RUN_USING_ENCODER);

        runtime.reset();

        while (opModeIsActive() && runtime.seconds() < TURN_TIMEOUT_SECONDS) {

            double error = normalizeDegrees(targetHeading - getHeading());

            if (Math.abs(error) <= TURN_TOLERANCE_DEGREES) {
                break;
            }

            // Slow down as it gets close; positive error means turn left
            double power = Math.abs(error) * TURN_KP;
            power = Math.max(TURN_MIN_POWER, Math.min(TURN_POWER, power));
            power = Math.signum(error) * power;

            frontLeft.setPower(-power);
            backLeft.setPower(-power);
            frontRight.setPower(power);
            backRight.setPower(power);

            telemetry.addData("Target heading", "%.1f", targetHeading);
            telemetry.addData("Heading", "%.1f", getHeading());
            telemetry.update();
            idle();
        }

        setDrivePower(0);
    }

    private double getHeading() {
        return imu.getRobotYawPitchRollAngles().getYaw(AngleUnit.DEGREES);
    }

    private double normalizeDegrees(double degrees) {
        while (degrees > 180) degrees -= 360;
        while (degrees <= -180) degrees += 360;
        return degrees;
    }

    private void setDrivePower(double power) {
        frontLeft.setPower(power);
        frontRight.setPower(power);
        backLeft.setPower(power);
        backRight.setPower(power);
    }

    private void stopAllMotors() {
        setDrivePower(0);

        launcherMotor.setPower(0);
        feederServo.setPower(0);

        setIntake(false);
    }

    private void waitSeconds(double seconds) {

        runtime.reset();

        while (opModeIsActive()
                && runtime.seconds() < seconds) {
            idle();
        }
    }
}
